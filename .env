# ============================================================
# Iran Life Bot — environment configuration
# Copy this file to `.env` and fill in the real values.
# NEVER commit the real .env file.
# ============================================================

# Bot token from @BotFather (REQUIRED)
BOT_TOKEN=your_bot_token_here

# SQLAlchemy async database URL.
# Default is SQLite; later, PostgreSQL can be used without code changes, e.g.:
#   postgresql+asyncpg://user:password@localhost:5432/iran_life
DATABASE_URL=sqlite+aiosqlite:///data/iran_life_bot.db

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Admin Telegram user IDs (comma-separated), for dev tools like /admin_add_xp
# Example: ADMIN_IDS=123456789,987654321
# Leave empty in production to disable admin commands
ADMIN_IDS=8154313073
